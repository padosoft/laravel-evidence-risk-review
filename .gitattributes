# Keep the Composer dist archive limited to the runtime package
# (src/, config/, database/, routes/, resources/openapi.yaml, composer.json,
# README.md, LICENSE, SECURITY.md). Docs tooling and its Node lockfile, CI,
# tests, agent files and repo-only artwork never reach vendor/.
/.claude export-ignore
/.github export-ignore
/docs export-ignore
/docs-site export-ignore
/skills export-ignore
/tests export-ignore
/resources/laravel-evidence-risk-preview-Banner.png export-ignore
/resources/screenshots export-ignore
/.env.example export-ignore
/.gitattributes export-ignore
/.gitignore export-ignore
/AGENTS.md export-ignore
/CLAUDE.md export-ignore
/CODE_OF_CONDUCT.md export-ignore
/CONTRIBUTING.md export-ignore
/phpstan.neon.dist export-ignore
/phpunit.xml export-ignore
/pint.json export-ignore
